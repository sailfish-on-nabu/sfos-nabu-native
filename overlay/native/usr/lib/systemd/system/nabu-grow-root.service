[Unit]
Description=Expand persistent Sailfish root filesystem
After=systemd-remount-fs.service
Before=systemd-user-sessions.service
ConditionPathExists=!/var/lib/nabu/root-expanded
[Service]
Type=oneshot
TimeoutStartSec=0
ExecStart=/usr/local/sbin/nabu-grow-root
[Install]
WantedBy=multi-user.target
