[Unit]
Description=Prepare the persistent nabu Wi-Fi MAC address
DefaultDependencies=no
Requires=systemd-remount-fs.service
After=systemd-remount-fs.service
Before=systemd-udevd.service systemd-udev-trigger.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nabu-wifi-mac

[Install]
WantedBy=sysinit.target
