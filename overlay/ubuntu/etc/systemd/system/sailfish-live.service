[Unit]
Description=Sailfish OS 5.3 Live session
After=systemd-user-sessions.service systemd-networkd.service systemd-resolved.service
Wants=systemd-networkd.service systemd-resolved.service
Conflicts=getty@tty7.service

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/usr/local/bin/sailfish-session
ExecStop=-/usr/bin/machinectl terminate sailfish
Restart=always
RestartSec=5
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
KillMode=control-group
TimeoutStopSec=90

[Install]
WantedBy=graphical.target
