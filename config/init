#!/bin/busybox sh
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /newroot
mount -t devpts devpts /dev/pts
exec </dev/console >/dev/console 2>&1
rescue() {
    echo "Sailfish could not mount SFOS_ROOT. Inspect blkid and dmesg."
    exec sh
}
echo "Starting installed Sailfish OS @IMAGE_VERSION@ for nabu"
modprobe nt36523_ts 2>/dev/null || true
root_device=""
for attempt in $(seq 1 180); do
    root_device=$(blkid 2>/dev/null | sed -n 's/^\([^:]*\):.*LABEL="SFOS_ROOT".*/\1/p' | head -n 1)
    [ -n "$root_device" ] && break
    sleep 1
done
[ -n "$root_device" ] || rescue
e2fsck -p "$root_device"
fsck_status=$?
[ "$fsck_status" -le 1 ] || rescue
mount -t ext4 -o rw "$root_device" /newroot || rescue
[ -x /newroot/sbin/init ] || rescue
mkdir -p /newroot/run /newroot/proc /newroot/sys /newroot/dev
mount -t tmpfs tmpfs /newroot/run
printf '%s\n' "$root_device" > /newroot/run/sfos-root-device
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
